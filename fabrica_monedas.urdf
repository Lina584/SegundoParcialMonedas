<?xml version="1.0"?>
<robot name="fabrica_estable_v3">

  <!-- ============ MATERIALES ============ -->
  <material name="blue_metal"><color rgba="0.05 0.15 0.35 1.0"/></material>
  <material name="black_rubber"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="white_machine"><color rgba="0.95 0.95 0.98 1.0"/></material>
  <material name="base_material"><color rgba="0.3 0.3 0.3 1"/></material>
  <material name="brazo1_material"><color rgba="0.2 0.6 0.8 1"/></material>
  <material name="brazo2_material"><color rgba="0.9 0.5 0.1 1"/></material>
  <material name="pinza_material"><color rgba="0.8 0.2 0.2 1"/></material>
  <material name="dedo_material"><color rgba="0.9 0.9 0.9 1"/></material>
  <material name="carro_material"><color rgba="0.1 0.3 0.6 1"/></material>

  <!-- ========================================== -->
  <!-- CINTA TRANSPORTADORA ÚNICA: una sola banda continua, desde   -->
  <!-- la entrada de las monedas hasta el punto de recogida de los  -->
  <!-- vasos (antes eran dos bandas separadas por la máquina de     -->
  <!-- embalaje; se quitó la máquina porque no cumplía ninguna      -->
  <!-- función y se unificó todo en un solo cuerpo de banda)        -->
  <!-- ========================================== -->
  <link name="cinta_transportadora">
    <visual><geometry><box size="2.3 0.4 0.1"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="blue_metal"/></visual>
    <visual><geometry><box size="2.2 0.3 0.05"/></geometry><origin xyz="0 0 0.08" rpy="0 0 0"/><material name="black_rubber"/></visual>
    <visual><geometry><box size="1.65 1.3 0.1"/></geometry><origin xyz="1.975 0 0" rpy="0 0 0"/><material name="blue_metal"/></visual>
    <visual><geometry><box size="1.55 1.2 0.05"/></geometry><origin xyz="1.975 0 0.08" rpy="0 0 0"/><material name="black_rubber"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.4"/></geometry><origin xyz="-1.1 0.15 -0.25" rpy="0 0 0"/><material name="black_rubber"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.4"/></geometry><origin xyz="-1.1 -0.15 -0.25" rpy="0 0 0"/><material name="black_rubber"/></visual>
    <visual><geometry><cylinder radius="0.05" length="1.3"/></geometry><origin xyz="2.75 0 -0.05" rpy="1.5708 0 0"/><material name="black_rubber"/></visual>
    <inertial><mass value="30.0"/><inertia ixx="15.0" ixy="0.0" ixz="0.0" iyy="15.0" iyz="0.0" izz="2.0"/></inertial>
  </link>

  <!-- ========================================== -->
  <!-- CONSTRUCCIÓN DE LA FÁBRICA                  -->
  <!-- ========================================== -->

  <link name="base_planta">
    <inertial><mass value="1000.0"/><inertia ixx="100.0" ixy="0.0" ixz="0.0" iyy="100.0" iyz="0.0" izz="100.0"/></inertial>
  </link>

  <joint name="j_cinta_transportadora" type="fixed">
    <parent link="base_planta"/><child link="cinta_transportadora"/><origin xyz="0.0 0.0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- SEPARADOR MECÁNICO: 3 canales inclinados que reparten -->
  <!-- las monedas del fin del tramo 1 hacia sus 3 vasos      -->
  <!-- ========================================== -->
  <link name="separador">
    <visual><geometry><box size="0.532 0.08 0.06"/></geometry><origin xyz="1.175 -0.200 0.55" rpy="0 0 -0.852"/><material name="base_material"/></visual>
    <visual><geometry><box size="0.350 0.08 0.06"/></geometry><origin xyz="1.175 0.000 0.55" rpy="0 0 0"/><material name="base_material"/></visual>
    <visual><geometry><box size="0.532 0.08 0.06"/></geometry><origin xyz="1.175 0.200 0.55" rpy="0 0 0.852"/><material name="base_material"/></visual>
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/></inertial>
  </link>
  <joint name="j_separador" type="fixed">
    <parent link="base_planta"/><child link="separador"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


</robot>
